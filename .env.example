# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which tenant row to load from the `tenants` table (see
# supabase-schema-tenants.sql). Leave unset for local dev / the default
# single-tenant Hugo build — it falls back to src/client.config.js.
VITE_TENANT_SLUG=hugo

# Cloudflare Turnstile site key (public) for the bot check on joining and staff
# sign-in. Must match the secret key set in Supabase → Authentication → Attack
# Protection. Leave unset only if CAPTCHA is off in that Supabase project.
VITE_TURNSTILE_SITE_KEY=
